  <library_effects>
    <effect id="tragetSquare5-effect">
      <profile_COMMON>
        <newparam sid="tragetSquare5Base-surface">
          <surface type="2D">
            <init_from>tragetSquare5Base</init_from>
          </surface>
        </newparam>
        <newparam sid="tragetSquare5Base-sampler">
          <sampler2D>
            <source>tragetSquare5Base-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="tragetSquare5Base-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
